<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.beautysalon.Controller.ClientProfileController"
        stylesheets="@../css/ClientProfile.css"
        prefWidth="1100"
        prefHeight="700"
        styleClass="root">

    <!-- TOP BAR -->
    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <children>

                <VBox spacing="4">

                    <children>

                        <Label text="Profili i klientit"
                               styleClass="title-label"/>

                        <Label text="Menaxhoni informacionin e klientit dhe historikun e shërbimit"
                               styleClass="subtitle-label"/>

                    </children>

                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">

    <Button fx:id="editBtn"
            text="Ndrysho të dhënat"
            styleClass="action-btn"/>

    <Button fx:id="saveBtn"
            text="Ruaj ndryshimet"
            visible="false"
            managed="false"
            styleClass="save-btn"/>

    <Button fx:id="cancelBtn"
            text="Anulo ndryshimet"
            visible="false"
            managed="false"
            styleClass="cancel-btn"/>

    <Button fx:id="deleteBtn"
            text="Fshi"
            styleClass="delete-btn"/>

    <Button fx:id="rollbackBtn"
            text="← Kthehu"
            styleClass="rollback-btn"/>

</HBox>

            </children>

        </HBox>

    </top>

    <!-- CENTER CONTENT -->
    <center>

        <VBox spacing="20"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="10" right="25" bottom="25" left="25"/>
            </padding>

            <children>

                <!-- CLIENT INFO CARD -->
                <VBox spacing="18"
                      styleClass="card">

                    <children>

                        <Label text="Informacioni i Klientit"
                               styleClass="section-title"/>

                      <GridPane hgap="18"
          vgap="18">

   <columnConstraints>
    <ColumnConstraints percentWidth="33"/>
    <ColumnConstraints percentWidth="33"/>
    <ColumnConstraints percentWidth="34"/>
</columnConstraints>

    <!-- ROW 1 -->
    <VBox spacing="8"
          GridPane.rowIndex="0"
          GridPane.columnIndex="0">
        <children>
            <Label text="ID" styleClass="field-label"/>
            <TextField fx:id="idField" editable="false"/>
        </children>
    </VBox>

    <VBox spacing="8"
          GridPane.rowIndex="0"
          GridPane.columnIndex="1">
        <children>
            <Label text="Emri" styleClass="field-label"/>
            <TextField fx:id="emriField"/>
        </children>
    </VBox>

    <VBox spacing="8"
          GridPane.rowIndex="0"
          GridPane.columnIndex="2">
        <children>
            <Label text="Mbiemri" styleClass="field-label"/>
            <TextField fx:id="mbiemriField"/>
        </children>
    </VBox>

    <!-- ROW 2 -->
    <VBox spacing="8"
          GridPane.rowIndex="1"
          GridPane.columnIndex="0">
        <children>
            <Label text="Gjinia" styleClass="field-label"/>
            <TextField fx:id="gjiniaField" editable="false"/>
        </children>
    </VBox>

    <VBox spacing="8"
          GridPane.rowIndex="1"
          GridPane.columnIndex="1">
        <children>
            <Label text="Numri Telefonit" styleClass="field-label"/>
            <TextField fx:id="numriTelField"/>
        </children>
    </VBox>

    <VBox spacing="8"
          GridPane.rowIndex="1"
          GridPane.columnIndex="2">
        <children>
            <Label text="Username" styleClass="field-label"/>
            <TextField fx:id="usernameField" editable="false"/>
        </children>
    </VBox>

   <!-- EMAIL (wide) -->
<GridPane GridPane.rowIndex="2"
          GridPane.columnIndex="0"
          GridPane.columnSpan="3"
          hgap="18">

    <columnConstraints>
        <ColumnConstraints percentWidth="50"/>
        <ColumnConstraints percentWidth="50"/>
    </columnConstraints>

    <!-- EMAIL -->
    <VBox spacing="8" GridPane.columnIndex="0">
        <children>
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField"
                       editable="false"
                       maxWidth="Infinity"/>
        </children>
    </VBox>

    <!-- DATA REGJISTRIMIT -->
    <VBox spacing="8" GridPane.columnIndex="1">
        <children>
            <Label text="Data Regjistrimit" styleClass="field-label"/>
            <TextField fx:id="dataRegjistrimitField"
                       editable="false"
                       maxWidth="Infinity"/>
        </children>
    </VBox>

</GridPane>

<!-- DESCRIPTION -->
<VBox spacing="8"
      GridPane.rowIndex="3"
      GridPane.columnIndex="1"
      GridPane.columnSpan="1"
      alignment="CENTER">

    <children>

        <Label text="Përshkrimi"
               styleClass="field-label"/>

        <TextArea fx:id="pershkrimiField"
          prefRowCount="8"
          prefHeight="180"
          maxWidth="650"
          wrapText="true"
          styleClass="description-area"/>

    </children>

</VBox>

</GridPane>

                    </children>

                </VBox>

                <!-- HISTORY TABLE CARD -->
                <VBox spacing="15"
                      VBox.vgrow="ALWAYS"
                      styleClass="card">

                    <children>

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <VBox spacing="3">

                                    <children>

                                        <Label text="Historia e Shërbimeve"
                                               styleClass="section-title"/>

                                        <Label text="Klikoni dy herë në një rresht për të parë detajet"
                                               styleClass="subtitle-label"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <TableView fx:id="historyField"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="idCol"
                                             text="ID"
                                             prefWidth="120"
                                             editable="false"
                                             sortable="false"/>

                                <TableColumn fx:id="emriPunonjesitCol"
                                             text="Punonjësi"
                                             prefWidth="250"
                                             editable="false"/>

                                <TableColumn fx:id="dataSherbimitCol"
                                             text="Data e shërbimit"
                                             prefWidth="350"
                                             editable="false"
                                             sortable="false"/>

                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>