<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.beautysalon.Controller.ClientProfileController"
        stylesheets="@../css/ClientProfile.css"
        prefWidth="1100"
        prefHeight="700"
        styleClass="root">

    <!-- TOP BAR -->
    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <children>

                <VBox spacing="4">

                    <children>

                        <Label text="Profili i klientit"
                               styleClass="title-label"/>

                        <Label text="Menaxhoni informacionin e klientit dhe historikun e shërbimit"
                               styleClass="subtitle-label"/>

                    </children>

                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <HBox spacing="10" alignment="CENTER_RIGHT">

    <Button fx:id="editBtn"
            text="Ndrysho të dhënat"
            styleClass="action-btn"/>

    <Button fx:id="saveBtn"
            text="Ruaj ndryshimet"
            visible="false"
            managed="false"
            styleClass="save-btn"/>

    <Button fx:id="cancelBtn"
            text="Anulo ndryshimet"
            visible="false"
            managed="false"
            styleClass="cancel-btn"/>

    <Button fx:id="deleteBtn"
            text="Fshi"
            styleClass="delete-btn"/>

    <Button fx:id="rollbackBtn"
            text="← Kthehu"
            styleClass="rollback-btn"/>

</HBox>

            </children>

        </HBox>

    </top>

    <!-- CENTER CONTENT -->
    <center>
<VBox spacing="20" BorderPane.alignment="CENTER">

    <padding>
        <Insets top="10" right="25" bottom="25" left="25"/>
    </padding>

    <!-- ========================= -->
    <!-- CLIENT CARD -->
    <!-- ========================= -->
    <VBox spacing="18" styleClass="card">

        <Label text="Informacioni i Klientit" styleClass="section-title"/>

        <!-- EDITABLE SECTION -->
        <VBox spacing="14">

            <Label text="Të dhënat kryesore" styleClass="subtitle-label"/>

            <GridPane hgap="18" vgap="14">

                <columnConstraints>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="34"/>
                </columnConstraints>

                <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="Emri" styleClass="field-label"/>
                    <TextField fx:id="emriField"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="Mbiemri" styleClass="field-label"/>
                    <TextField fx:id="mbiemriField"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <Label text="Numri Telefonit" styleClass="field-label"/>
                    <TextField fx:id="numriTelField"/>
                </VBox>

                <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                    <Label text="Email" styleClass="field-label"/>
                    <TextField fx:id="emailField"/>
                </VBox>

                <!-- ✅ FIXED: NO OVERLAP, PROPER SPAN -->
                <VBox spacing="6"
                      GridPane.rowIndex="1"
                      GridPane.columnIndex="1"
                      GridPane.columnSpan="2"
                      maxWidth="500">

                    <Label text="Përshkrimi" styleClass="field-label"/>

                    <TextArea fx:id="pershkrimiField"
                              prefRowCount="5"
                              wrapText="true"
                              maxWidth="500"
                              styleClass="description-area"/>
                </VBox>

            </GridPane>
        </VBox>

        <!-- READONLY SECTION -->
        <VBox spacing="14">

            <Label text="Informacione sistemi" styleClass="subtitle-label"/>

            <GridPane hgap="18" vgap="12">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label text="ID" styleClass="field-label"/>
                    <Label fx:id="idLabel" styleClass="readonly-label"/>
                </VBox>

                <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="Gjinia" styleClass="field-label"/>
                    <Label fx:id="gjiniaLabel" styleClass="readonly-label"/>
                </VBox>

                <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="2">
                    <Label text="Username" styleClass="field-label"/>
                    <Label fx:id="usernameLabel" styleClass="readonly-label"/>
                </VBox>

                <VBox spacing="4" GridPane.rowIndex="0" GridPane.columnIndex="3">
                    <Label text="Regjistrimi" styleClass="field-label"/>
                    <Label fx:id="dataRegjistrimitLabel" styleClass="readonly-label"/>
                </VBox>

            </GridPane>
        </VBox>

    </VBox>

    <!-- ========================= -->
    <!-- TABLE CARD -->
    <!-- ========================= -->
    <VBox spacing="15" VBox.vgrow="ALWAYS" styleClass="card">

        <Label text="Historia e Shërbimeve" styleClass="section-title"/>

        <TableView fx:id="historyField" VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="120"/>
                <TableColumn fx:id="emriPunonjesitCol" text="Punonjësi" prefWidth="250"/>
                <TableColumn fx:id="dataSherbimitCol" text="Data e shërbimit" prefWidth="350"/>
            </columns>

        </TableView>

    </VBox>

</VBox>
</center>

</BorderPane>