<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.beautysalon.Controller.ClientProfileController"
        stylesheets="@../css/ClientProfile.css"
        prefWidth="1100"
        prefHeight="700"
        styleClass="root">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="20" right="25" bottom="20" left="25"/>
            </padding>

            <children>

                <VBox spacing="4">
                    <children>
                        <Label text="Client Profile"
                               styleClass="title-label"/>

                        <Label text="Manage client information and service history"
                               styleClass="subtitle-label"/>
                    </children>
                </VBox>

                <HBox HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="rollbackBtn"
                        text="← Back to Clients"
                        styleClass="rollback-btn"/>

            </children>
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>

        <VBox spacing="20"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="10" right="25" bottom="25" left="25"/>
            </padding>

            <children>

                <!-- CLIENT INFO CARD -->
                <VBox spacing="18"
                      styleClass="card">

                    <children>

                        <Label text="Client Information"
                               styleClass="section-title"/>

                        <HBox spacing="15">

                            <children>

                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="First Name"
                                               styleClass="field-label"/>

                                        <TextField fx:id="emriField"
                                                   promptText="Client first name"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Last Name"
                                               styleClass="field-label"/>

                                        <TextField fx:id="mbiemriField"
                                                   promptText="Client last name"/>
                                    </children>
                                </VBox>

                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Phone Number"
                                               styleClass="field-label"/>

                                        <TextField fx:id="numriTelField"
                                                   promptText="+383 XX XXX XXX"/>
                                    </children>
                                </VBox>

                            </children>

                        </HBox>

                    </children>

                </VBox>

                <!-- HISTORY TABLE CARD -->
                <VBox spacing="15"
                      VBox.vgrow="ALWAYS"
                      styleClass="card">

                    <children>

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <VBox spacing="3">
                                    <children>
                                        <Label text="Service History"
                                               styleClass="section-title"/>

                                        <Label text="Double click a row to view details"
                                               styleClass="subtitle-label"/>
                                    </children>
                                </VBox>

                            </children>

                        </HBox>

                        <TableView fx:id="historyField"
                                   VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn fx:id="idCol"
                                             text="ID"
                                             prefWidth="120"
                                             editable="false"
                                             sortable="false"/>

                                <TableColumn fx:id="emriPunonjesitCol"
                                             text="Employee"
                                             prefWidth="250"
                                             editable="false"/>

                                <TableColumn fx:id="dataSherbimitCol"
                                             text="Service Date"
                                             prefWidth="350"
                                             editable="false"
                                             sortable="false"/>

                            </columns>

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                        </TableView>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>