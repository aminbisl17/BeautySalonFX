<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750.0" 
            prefWidth="1200.0" 
            styleClass="root"
            stylesheets="@../css/ServiceRegisterForm.css" 
            xmlns="http://javafx.com/javafx/25" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.beautysalon.Controller.ServiceRegisterFormController">

    <center>
        <ScrollPane fitToWidth="true" 
                    hbarPolicy="NEVER" 
                    vbarPolicy="AS_NEEDED" 
                    styleClass="form-scroll">
            <content>
                <VBox spacing="24.0" styleClass="form-container">
                    <padding>
                        <Insets top="24.0" bottom="40.0" left="32.0" right="32.0" />
                    </padding>

                    <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                        <VBox spacing="4.0">
                            <Label text="Regjistro shërbim" styleClass="title-label"/>
                            <Label text="Plotëso të dhënat për shërbimin e ri" styleClass="subtitle-label"/>
                        </VBox>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                        
                        <Button fx:id="rollbackBtn" 
                                styleClass="rollback-btn" 
                                text="← Kthehu" />
                    </HBox>

                    <VBox spacing="18.0" styleClass="card">
                        <Label text="Të dhënat e shërbimit" styleClass="section-title"/>

                        <VBox spacing="6.0">
                            <Label text="Emri i shërbimit" styleClass="field-label"/>
                            <TextField fx:id="nameField" 
                                       promptText="p.sh. Prerje flokësh" 
                                       styleClass="form-field"/>
                        </VBox>

                        <VBox spacing="6.0">
                            <Label text="Përshkrimi" styleClass="field-label"/>
                            <TextArea fx:id="descriptionField" 
                                      prefRowCount="3" 
                                      promptText="Përshkruaj shërbimin..." 
                                      styleClass="form-textarea" 
                                      wrapText="true"/>
                        </VBox>

                        <GridPane hgap="16.0" vgap="6.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.33"/>
                                <ColumnConstraints percentWidth="33.33"/>
                                <ColumnConstraints percentWidth="33.33"/>
                            </columnConstraints>

                            <VBox spacing="6.0" GridPane.columnIndex="0">
                                <Label text="Çmimi bazë (€)" styleClass="field-label"/>
                                <TextField fx:id="priceField" 
                                           promptText="0.00" 
                                           styleClass="form-field"/>
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="1">
                                <Label text="Zbritja (%)" styleClass="field-label"/>
                                <TextField fx:id="discountField" 
                                           promptText="0" 
                                           styleClass="form-field"/>
                            </VBox>

                            <VBox spacing="6.0" GridPane.columnIndex="2">
                                <Label text="Kohëzgjatja (min)" styleClass="field-label"/>
                                <TextField fx:id="durationField" 
                                           promptText="60" 
                                           styleClass="form-field"/>
                            </VBox>
                        </GridPane>

                        <VBox spacing="10.0">
                            <Label text="Foto e shërbimit" styleClass="field-label"/>
                            
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Button fx:id="chooseImageButton" 
                                        onAction="#chooseImage" 
                                        styleClass="secondary-btn" 
                                        text="Zgjidh foto"/>
                                <Label fx:id="imageNameLabel" 
                                       styleClass="subtitle-label" 
                                       text="Asnjë foto e zgjedhur"/>
                            </HBox>

                            <ImageView fx:id="imagePreview" 
                                       fitHeight="120.0" 
                                       fitWidth="180.0" 
                                       preserveRatio="true" 
                                       styleClass="service-image"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="16.0" styleClass="card">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="2.0">
                                <Label text="Opsionet e shërbimit" styleClass="section-title"/>
                                <Label text="Shto variante ose opsione për këtë shërbim" styleClass="subtitle-label"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="addAttributeButton" 
                                    onAction="#addAttribute" 
                                    styleClass="secondary-btn" 
                                    text="+ Shto opsion"/>
                        </HBox>

                        <VBox fx:id="attributesContainer" spacing="12.0"/>
                    </VBox>

                    <Label fx:id="errorLabel" 
                           managed="false" 
                           styleClass="error-label" 
                           visible="false" 
                           wrapText="true"/>

                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="cancelButton" 
                                onAction="#cancel" 
                                styleClass="cancel-btn" 
                                text="Anulo"/>
                        <Button fx:id="registerButton" 
                                onAction="#register" 
                                styleClass="register-btn" 
                                text="+ Regjistro shërbim"/>
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>