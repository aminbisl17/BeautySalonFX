<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../css/profile.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beautysalon.Controller.profileviewController"
            styleClass="root">

    <center>

        <!-- CENTER COLUMN CONTAINER -->
        <HBox alignment="CENTER">

            <!-- VERTICAL PANEL -->
            <VBox styleClass="profile-panel" spacing="25">

                <padding>
                    <Insets top="40" right="50" bottom="40" left="50"/>
                </padding>

                <!-- HEADER -->
                <VBox spacing="6">
                    <Label text="Profile" styleClass="page-title"/>
                    <Label text="Account settings and personal information"
                           styleClass="page-subtitle"/>
                </VBox>

                <!-- USER HEADER -->
                <HBox spacing="15" alignment="CENTER_LEFT">

                    <ImageView fx:id="avatar"
                               fitWidth="80"
                               fitHeight="80"
                               styleClass="avatar"/>

                    <VBox spacing="4">
                        <Label fx:id="emriField" styleClass="username"/>
                        <Label fx:id="roleField" styleClass="role-text"/>
                        <Label text="Active account" styleClass="muted-text"/>
                    </VBox>

                </HBox>

                <!-- DIVIDER -->
                <VBox styleClass="divider"/>

                <!-- INFO -->
                <VBox spacing="12">

                    <Label text="Account Information" styleClass="section-title"/>

                    <Label text="Username" styleClass="label"/>
                    <Label fx:id="usernameField" styleClass="value"/>

                    <Label text="Phone" styleClass="label"/>
                    <Label fx:id="phoneField" styleClass="value"/>

                    <Label text="Registration Date" styleClass="label"/>
                    <Label fx:id="dataField" styleClass="value"/>

                </VBox>

                <!-- DIVIDER -->
                <VBox styleClass="divider"/>

                <!-- ACTIONS -->
                <HBox spacing="10">

                    <Button text="Edit Profile"
                            styleClass="primary-btn"/>

                    <HBox HBox.hgrow="ALWAYS"/>

                    <Button fx:id="logoutbtn"
                            text="Logout"
                            styleClass="logout-btn"/>

                </HBox>

            </VBox>

        </HBox>

    </center>

</BorderPane>