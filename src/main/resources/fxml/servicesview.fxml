<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.beautysalon.Controller.servicesviewController"
        stylesheets="@../css/tables.css"
        prefWidth="1200"
        prefHeight="750">

    <!-- TOP HEADER -->
    <top>

        <HBox spacing="15"
              alignment="CENTER_LEFT"
              styleClass="top-bar">

            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <children>

                <VBox spacing="4">

                    <children>

                        <Label text="Services Dashboard"
                               styleClass="title-label"/>

                        <Label text="Manage salon services and pricing"
                               styleClass="subtitle-label"/>

                    </children>

                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button
                        fx:id="refreshbtn"
                        text="⟳ Refresh"
                        styleClass="primary-btn"/>

            </children>

        </HBox>

    </top>

    <!-- TABLE CONTENT -->
    <center>

        <VBox BorderPane.alignment="CENTER">

            <padding>
                <Insets top="0" right="40" bottom="35" left="40"/>
            </padding>

            <children>

                <VBox spacing="18"
                      VBox.vgrow="ALWAYS"
                      styleClass="card">

                    <children>

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <VBox spacing="3">

                                    <children>

                                        <Label text="Services Table"
                                               styleClass="section-title"/>

                                        <Label text="View and manage all salon services"
                                               styleClass="subtitle-label"/>

                                    </children>

                                </VBox>

                            </children>

                        </HBox>

                        <TableView fx:id="table"
                                   VBox.vgrow="ALWAYS"/>

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>
