            <BorderPane fx:id="weekCal">
               <top>
                  <HBox prefHeight="50.0" style="-fx-background-color: red;" BorderPane.alignment="CENTER" />
               </top>
               <left>
                  <VBox fx:id="leftpane" prefWidth="50.0" style="-fx-background-color: red;" BorderPane.alignment="CENTER" />
               </left>
            </BorderPane>
         </children>
      </StackPane>
   </center>
   <right>
      <VBox prefWidth="150.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" text="Button" />
            <Button mnemonicParsing="false" text="Button" />
