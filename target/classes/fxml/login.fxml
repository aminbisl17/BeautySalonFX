<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root"
            prefHeight="400.0"
            prefWidth="327.0"
            stylesheets="@../css/authentication.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.beautysalon.Controller.loginController"
            styleClass="root">

   <children>

      <!-- CENTER CONTAINER -->
      <VBox layoutX="0" layoutY="0"
            prefWidth="327.0"
            prefHeight="400.0"
            spacing="20"
            alignment="CENTER"
            styleClass="card">

         <!-- TITLE -->
         <Label text="Authenticate"
                textFill="WHITE">
            <font>
               <Font size="32.0"/>
            </font>
         </Label>

         <!-- LOADING TEXT -->
         <Label fx:id="loadingLabel"
                text="Loading..."
                styleClass="label"
                id="loadingLabel"/>

         <!-- QR CODE -->
         <ImageView fx:id="qrcode"
                    fitHeight="220.0"
                    fitWidth="220.0"
                    visible="false"
                    pickOnBounds="true"
                    preserveRatio="true"
                    styleClass="image-view"/>

      </VBox>

   </children>
</AnchorPane>