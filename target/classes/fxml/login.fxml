<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="root" prefHeight="400.0" prefWidth="327.0" styleClass="root" stylesheets="@../css/authentication.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.beautysalon.Controller.loginController">

   <children>

      <!-- CENTER CONTAINER -->
      <VBox alignment="CENTER" layoutX="0" layoutY="0" prefHeight="400.0" prefWidth="327.0" spacing="20" styleClass="card">

         <!-- LOADING TEXT -->
         <Label id="loadingLabel" fx:id="loadingLabel" alignment="CENTER" prefHeight="40.0" prefWidth="138.0" styleClass="label" text="Loading..." textAlignment="CENTER">
            <font>
               <Font size="24.0" />
            </font></Label>

         <!-- QR CODE -->
         <ImageView fx:id="qrcode" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" styleClass="image-view" visible="false" />

      </VBox>

   </children>
</AnchorPane>
