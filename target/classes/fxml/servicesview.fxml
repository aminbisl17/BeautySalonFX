<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="750" prefWidth="1200" styleClass="root" stylesheets="@../css/tables.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.beautysalon.Controller.servicesviewController">

    <!-- TOP HEADER -->
    <top>

        <HBox alignment="CENTER_LEFT" spacing="15" styleClass="top-bar">

            <padding>
                <Insets bottom="20" left="40" right="40" top="20" />
            </padding>

            <children>

                <VBox spacing="4">

                    <children>

                        <Label styleClass="title-label" text="Paneli i shërbimeve" />

                    
                        <Label styleClass="subtitle-label" text="Menaxho shërbimet" />
            
                    </children>

                </VBox>

                <Region HBox.hgrow="ALWAYS" />

             <TextField fx:id="searchField" promptText="Kërko shërbim..." styleClass="search-field" />

                <Button fx:id="refreshbtn" styleClass="primary-btn" text="⟳ Rifresko" />

            </children>

        </HBox>

    </top>

    <!-- TABLE CONTENT -->
    <center>

        <VBox BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="35" left="40" right="40" top="0" />
            </padding>

            <children>

                <VBox spacing="18" styleClass="card" VBox.vgrow="ALWAYS">

                    <children>

                        <HBox alignment="CENTER_LEFT">

                            <children>

                                <VBox spacing="3">

                                    <children>

                                        <Label styleClass="section-title" text="Tabela e shërbimeve" />

                                        <Label styleClass="subtitle-label" text="Shiko detajet e shërbimeve" />

                                    </children>

                                </VBox>

                                    <Region HBox.hgrow="ALWAYS" />

                       <Button
    fx:id="registerbtn"
    mnemonicParsing="false"
    styleClass="register-btn"
    text="+  Regjistro shërbim" />

                            </children>

                        </HBox>

                        <TableView fx:id="table" VBox.vgrow="ALWAYS" />

                    </children>

                </VBox>

            </children>

        </VBox>

    </center>

</BorderPane>
